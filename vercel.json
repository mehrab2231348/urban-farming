{
  "version": 2,
  "functions": {
    "api/router.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/login.html",
      "dest": "/public/login.html"
    },
    {
      "src": "/index.html",
      "dest": "/public/index.html"
    },
    {
      "src": "/api/(.*\\.php)",
      "dest": "/api/router.php"
    },
    {
      "src": "/(.*\\.php)",
      "dest": "/api/router.php"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    }
  ]
}
